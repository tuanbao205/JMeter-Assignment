<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JMeter API Load Test" enabled="true">
      <stringProp name="TestPlan.comments">Bai thuc hanh JMeter: kiem thu API JSONPlaceholder</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
